rules_version = '2';

// BookHub Firebase Storage rules — DENY BY DEFAULT.
// Paste into: Firebase Console → Storage → Rules. Keep this file the source
// of truth; the console copy must always match it (same convention as
// firestore.rules).
//
// BookHub uses NO Firebase Storage today: the storageBucket is declared in
// the Firebase web config (_includes/firebase.html) but no Storage SDK is
// loaded and no object is ever read or written. User-uploaded PDF *text* is
// sent to the API and stored ephemerally in Redis — never to Storage. So the
// bucket must be closed completely until there is a real, scoped need.
//
// If Storage is ever adopted, DO NOT open this wide. Replace the catch-all
// below with explicit, owner-scoped, size/content-type-limited paths, e.g.:
//
//   match /users/{uid}/{fileName} {
//     allow read, write: if request.auth != null
//       && request.auth.uid == uid
//       && request.resource.size < 5 * 1024 * 1024
//       && request.resource.contentType.matches('image/.*');
//   }
//
// (Security audit M-06, 2026-07-24.)

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
